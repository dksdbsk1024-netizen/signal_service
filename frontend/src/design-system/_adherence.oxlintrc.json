{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/_shared/**",
              "ui_kits/app-shell/**",
              "ui_kits/flow-tab/**",
              "ui_kits/macro-tab/**",
              "ui_kits/overview-tab/**",
              "ui_kits/screener-tab/**",
              "ui_kits/settings-tab/**",
              "ui_kits/technical-tab/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='Candle'] > JSXAttribute > JSXIdentifier[name!=/^(?:t|o|h|l|c|v|key|ref|className|style|children)$/]",
        "message": "<Candle> doesn't accept that prop. Declared props: t, o, h, l, c, v."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContributionBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|score|weight|key|ref|className|style|children)$/]",
        "message": "<ContributionBarItem> doesn't accept that prop. Declared props: name, score, weight."
      },
      {
        "selector": "JSXOpeningElement[name.name='DirectionGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|size|showScoreLabel|subtitle|key|ref|className|style|children)$/]",
        "message": "<DirectionGauge> doesn't accept that prop. Declared props: score, size, showScoreLabel, subtitle."
      },
      {
        "selector": "JSXOpeningElement[name.name='DirectionGauge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<DirectionGauge> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicatorRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|signal|key|ref|className|style|children)$/]",
        "message": "<IndicatorRow> doesn't accept that prop. Declared props: name, value, signal."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicatorRow'] > JSXAttribute[name.name='signal'] > Literal[value!=/^(?:buy|sell|neutral)$/]",
        "message": "<IndicatorRow> signal must be one of 'buy' | 'sell' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|ticker|price|changePct|changeAmt|volume|marketCap|marketStatus|key|ref|className|style|children)$/]",
        "message": "<StockHeader> doesn't accept that prop. Declared props: name, ticker, price, changePct, changeAmt, volume, marketCap, marketStatus."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockHeader'] > JSXAttribute[name.name='marketStatus'] > Literal[value!=/^(?:open|closed|after)$/]",
        "message": "<StockHeader> marketStatus must be one of 'open' | 'closed' | 'after'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StockSuggestion'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|ticker|key|ref|className|style|children)$/]",
        "message": "<StockSuggestion> doesn't accept that prop. Declared props: name, ticker."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Candle": {
        "replaces": []
      },
      "ContributionBarItem": {
        "replaces": []
      },
      "DirectionGauge": {
