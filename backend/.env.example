# backend 환경변수 템플릿. 복사해서 backend/.env 로 쓰고 값을 채운다.
#   cp backend/.env.example backend/.env
#
# 모두 선택사항 — 키가 없거나 비면 core.macro 가 지표를 Mock 으로 폴백한다.
# (앱은 키 없이도 Mock 데이터로 정상 구동. 실데이터가 필요할 때만 채운다.)

# 미국 경제지표 (FRED, https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# 한국 경제지표 (ECOS 한국은행, https://ecos.bok.or.kr/api/#/AuthKeyApply)
ECOS_API_KEY=

# 국내 시세/주문 (KIS 한국투자증권, https://apiportal.koreainvestment.com)
# 실전투자 도메인 사용. 발급된 토큰은 backend/.kis_token.json 에 캐시된다
# (자동 생성, gitignore). KIS 는 앱키당 토큰 발급을 1분에 1회로 제한하므로
# 이 파일을 지우고 바로 재실행하면 EGW00133 으로 막힐 수 있다.
# KIS_ACCOUNT_NO 는 현재가 조회엔 불필요 — 주문·잔고 단계에서 쓴다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# 종목 데이터 소스 강제. auto(기본) = KIS 키 있으면 실데이터, 없으면 Mock.
# mock = 키가 있어도 Mock (오프라인 개발용. pytest 는 conftest 가 알아서 mock 으로 고정).
STOCK_PROVIDER=auto

# 매크로 시세(yfinance) 네트워크 호출. 1(기본) = 실데이터, 0 = Mock.
# 경제지표는 FRED/ECOS 키 유무로 갈리지만 yfinance 는 키가 없어도 네트워크를 타서 노브가 따로 있다.
MACRO_LIVE_QUOTES=1


# ── 수집기 (아래는 전부 기본값 있음. 안 건드려도 앱은 정상 구동) ──────────
#
# 수집기는 API 프로세스 안에서 백그라운드 스케줄러로 돈다. 유니버스 200종목을
# 주기적으로 돌며 스냅샷을 SQLite 에 쓰고, 라우트는 그 스냅샷만 읽는다.

# 스케줄러 기동 여부. 1(기본) = 켬. 0 = 끔 — 라우트는 남은 스냅샷을 계속 서빙한다.
# pytest 는 conftest 가 0 으로 고정(안 그러면 매 테스트가 KIS 를 긁는다).
COLLECT_ENABLED=1

# 수집 주기(초). 기본 300. 실측상 1사이클이 약 381초라 주기보다 길다 —
# 그 경우 max_instances=1 이 다음 발화를 건너뛰어, 사실상 '끝나는 대로 다시' 가 된다.
COLLECT_INTERVAL_SEC=300

# 동시에 물고 있는 종목 수. 유량 상한이 아니라 '지연 흡수' 손잡이다 —
# 워커가 적으면 KIS 왕복을 기다리느라 KIS_MAX_RPS 를 채우지 못한다.
# HTTP 커넥션 풀도 이 값에 맞춰 잡힌다(max(32, N*2)).
COLLECT_WORKERS=24

# 스냅샷 DB 경로. 기본 backend/data/snapshots.db (자동 생성, gitignore).
# pytest 는 conftest 가 :memory: 로 고정.
SNAPSHOT_DB_PATH=

# KIS HTTP 호출 상한(초당). 문서상 약 20건이지만 실측에서 15건으로도
# EGW00201("초당 거래건수를 초과하였습니다")을 맞아 12 로 낮췄다.
# 토큰버킷은 프로세스마다 따로 존재한다 — 앱을 띄운 채 스크립트를 돌리면
# 합산 레이트가 한도를 넘으니, 검증할 땐 앱을 내릴 것.
KIS_MAX_RPS=12

# 스냅샷에 없는 종목을 요청받았을 때 즉석 조회할 최대 개수. 기본 16.
# 올리면 스크리너 첫 응답이 느려지고 KIS 호출이 는다.
SCREENER_COLD_LIMIT=16
